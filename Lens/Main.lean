import Lens.Pipeline

/-!
# Lens CLI

```
lake exe extract [--out FILE] [--pkg PKG] [--rt-pkg PKG] [--strip-prefix NS]
                 [--module NAME] [--root NAME]...
```

Defaults extract the Simplean library (`Lens.defaultRoots`) from the compiled
`Simplean` module into Scala package `simplean`, importing the runtime
prelude from `simplean.rt`. Without `--out` the Scala source goes to stdout.

All-or-nothing: on any translation error, every error is reported, the exit
code is 1 and no file is touched.
-/

open Lean

structure CliArgs where
  out : Option String := none
  pkg : String := "simplean"
  rtPkg : String := "simplean.rt"
  stripPrefix : Name := `Simplean
  module : Name := `Simplean
  roots : List Name := []

partial def parseArgs : List String → CliArgs → Except String CliArgs
  | [], acc => .ok acc
  | "--" :: rest, acc => parseArgs rest acc
  | "--out" :: v :: rest, acc => parseArgs rest { acc with out := some v }
  | "--pkg" :: v :: rest, acc => parseArgs rest { acc with pkg := v }
  | "--rt-pkg" :: v :: rest, acc => parseArgs rest { acc with rtPkg := v }
  | "--strip-prefix" :: v :: rest, acc => parseArgs rest { acc with stripPrefix := v.toName }
  | "--module" :: v :: rest, acc => parseArgs rest { acc with module := v.toName }
  | "--root" :: v :: rest, acc => parseArgs rest { acc with roots := acc.roots ++ [v.toName] }
  | arg :: _, _ => .error s!"unknown argument '{arg}'"

def main (args : List String) : IO UInt32 := do
  let cli ← match parseArgs args {} with
    | .ok c => pure c
    | .error msg => IO.eprintln s!"lens: {msg}"; return 2
  let roots := if cli.roots.isEmpty then Lens.defaultRoots else cli.roots
  let cfg : Lens.Config :=
    { pkg := cli.pkg, rtPkg := cli.rtPkg, stripPrefix := cli.stripPrefix,
      header := [s!"GENERATED by Lens from the `{cli.module}` Lean module. DO NOT EDIT.",
                 "Regenerate with `scripts/scala-check.sh` (UPDATE_GOLDEN=1 to accept a changed golden)."] }
  match ← Lens.runPipeline cli.module roots cfg with
  | .error errs =>
    Lens.reportErrors errs
    return 1
  | .ok text =>
    match cli.out with
    | none =>
      IO.println text
      return 0
    | some outFile =>
      let file : System.FilePath := outFile
      if let some dir := file.parent then
        IO.FS.createDirAll dir
      IO.FS.writeFile file text
      IO.println s!"lens: wrote {file} ({(text.splitOn "\n").length} lines, roots: {roots.length})"
      return 0
